rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función básica para verificar si el usuario es admin principal
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Función extendida para validar accesos por rol específico en el backend
    function hasAnyRole(roles) {
      return request.auth != null && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in roles;
    }

    // Catálogo Activo: Lectura pública, escritura exclusiva de administradores
    match /catalogo_activo/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catálogos por Sucursal: Lectura pública, escritura exclusiva de administradores
    match /sucursales_catalogos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos Globales: Solo clientes crean, personal administrativo gestiona de forma segura
    match /pedidos/{pedidoId} {
      allow create: if true;
      // Lectura y actualización permitida a Admin, Owner y Empleado de Sucursal
      allow read, update: if isAdmin() || hasAnyRole(['owner', 'empleado']);
      // Eliminación restrictiva: Solo administradores y el Dueño (owner) pueden depurar registros
      allow delete: if isAdmin() || hasAnyRole(['owner']);
    }
    
    // Pedidos Globales Auxiliares: Solo personal administrativo con rol jerárquico
    match /pedidos_globales/{document=**} {
      allow read, write: if isAdmin() || hasAnyRole(['owner']);
    }

    // Usuarios: Aislamiento estricto. Cada usuario lee su propio perfil. Solo Admin gestiona todo.
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || hasAnyRole(['owner']));
      allow write: if isAdmin();
    }

    // Configuración General del Sistema: Lectura pública, escritura exclusiva de administradores
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
