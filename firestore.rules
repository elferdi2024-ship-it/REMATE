rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si el usuario es admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Función para verificar si el usuario es administrador, dueño o empleado
    function isStaff() {
      return request.auth != null && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'owner', 'empleado'];
    }

    // Función para verificar si el usuario es administrador o dueño (owner)
    function isManager() {
      return request.auth != null && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // Función para validar que el payload de creación de pedido sea legítimo (Guest-First seguro)
    function isValidOrder() {
      let data = request.resource.data;
      return data.keys().hasAll(['items', 'total']) &&
             data.total is number &&
             data.total > 0 &&
             data.items is list &&
             data.items.size() > 0 &&
             data.items.size() <= 100 &&
             (!('clienteNombre' in data) || data.clienteNombre is string) &&
             (!('sucursalId' in data) || data.sucursalId is string) &&
             (!('estado' in data) || data.estado in ['pendiente', 'nuevo', 'En Preparación']);
    }

    // Catálogo: Cualquiera lee, solo admin escribe
    match /catalogo_activo/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catálogos por Sucursal: Cualquiera lee, solo admin escribe
    match /sucursales_catalogos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: Clientes crean, personal administrativo gestiona (lee/edita/borra)
    match /pedidos/{pedidoId} {
      allow create: if isValidOrder();
      allow read, update, delete: if isStaff();
    }
    
    // Pedidos Globales: Permitido crear a cualquiera. Leer/actualizar a Admin, Owner y Empleado. Borrado solo Admin/Owner.
    match /pedidos_globales/{document=**} {
      allow create: if isValidOrder();
      allow read, update, delete: if isStaff();
    }

    // Usuarios: Cada uno lee lo suyo, admin y owner leen todo
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
      allow write: if isAdmin();
    }

    // Historial de Pedidos del Usuario: Permitido al propio usuario
    match /usuarios/{userId}/pedidos/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Configuración (Categorías, etc): Cualquiera lee, solo admin escribe
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración de Sucursales: Cualquiera lee, solo admin escribe
    match /sucursales_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración de Tienda (config/tienda): Cualquiera lee, solo admin escribe
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
